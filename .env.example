# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_TEMPERATURE=0.6

# --- База данных ---
DATABASE_URL=sqlite:///./data/kazakh_tutor.db

# --- TTS (Piper / ISSAI) ---
TTS_ENABLED=true
TTS_ENGINE=piper
PIPER_BINARY_PATH=piper
PIPER_MODEL_PATH=./models/kk_KZ-issai-medium.onnx
TTS_OUTPUT_DIR=./data/audio_cache

# --- Приложение ---
APP_NAME=Kazakh AI Tutor
APP_ENV=development
CORS_ORIGINS=["*"]
LOG_LEVEL=INFO
